<?xml version="1.0" encoding="UTF-8"?>
<!-- Contrato WSDL del servicio ConversionesService -->
<definitions name="ConversionesService"
             targetNamespace="urn:conversiones"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="urn:conversiones"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- 1. TIPOS: elementos de entrada y salida con su tipo de dato -->
  <types>
    <xsd:schema targetNamespace="urn:conversiones" elementFormDefault="qualified">

      <xsd:element name="CelsiusAFahrenheit">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="celsius" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="CelsiusAFahrenheitResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="fahrenheit" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="KilometrosAMillas">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="kilometros" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="KilometrosAMillasResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="millas" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </types>

  <!-- 2. MENSAJES: entrada y salida de cada operación -->
  <message name="CelsiusAFahrenheitEntrada">
    <part name="parameters" element="tns:CelsiusAFahrenheit"/>
  </message>
  <message name="CelsiusAFahrenheitSalida">
    <part name="parameters" element="tns:CelsiusAFahrenheitResponse"/>
  </message>
  <message name="KilometrosAMillasEntrada">
    <part name="parameters" element="tns:KilometrosAMillas"/>
  </message>
  <message name="KilometrosAMillasSalida">
    <part name="parameters" element="tns:KilometrosAMillasResponse"/>
  </message>

  <!-- 3. PORT TYPE: operaciones que ofrece el servicio -->
  <portType name="ConversionesPortType">
    <operation name="CelsiusAFahrenheit">
      <input message="tns:CelsiusAFahrenheitEntrada"/>
      <output message="tns:CelsiusAFahrenheitSalida"/>
    </operation>
    <operation name="KilometrosAMillas">
      <input message="tns:KilometrosAMillasEntrada"/>
      <output message="tns:KilometrosAMillasSalida"/>
    </operation>
  </portType>

  <!-- 4. BINDING: cómo se usan las operaciones con SOAP sobre HTTP -->
  <binding name="ConversionesBinding" type="tns:ConversionesPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="CelsiusAFahrenheit">
      <soap:operation soapAction="urn:conversiones/CelsiusAFahrenheit"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="KilometrosAMillas">
      <soap:operation soapAction="urn:conversiones/KilometrosAMillas"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <!-- 5. SERVICE: dirección HTTP donde está publicado el servicio -->
  <service name="ConversionesService">
    <port name="ConversionesPort" binding="tns:ConversionesBinding">
      <soap:address location="http://localhost:3000/soap/conversiones"/>
    </port>
  </service>

</definitions>
